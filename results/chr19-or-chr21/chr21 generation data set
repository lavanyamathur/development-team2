#!/usr/bin/env bash
# scripts/fetch_gnnome_chr21_graph.sh
#
# Sets up GNNome's OWN pipeline and uses it to build the chr21 graph exactly
# the way the GNNome authors do -- this is what your README means by
# "GNNome's own published test graphs (chr19/chr21) -- used for direct
# comparability to GNNome's reported numbers."
#
# IMPORTANT: GNNome-assembly (lvrcek/GNNome-assembly), which is the repo name
# implied by older docs, is now DEPRECATED. Active development moved to:
#   https://github.com/lbcb-sci/GNNome
# This script targets the current repo.
#
# There is no separate downloadable "graph file" for chr21 -- GNNome builds
# it itself from the CHM13 reference via PBSIM3 + Raven/hifiasm, same as your
# own README's pipeline. Running this script IS "fetching the graph": it
# reproduces GNNome's exact construction so your team's chr21 graph is
# apples-to-apples with the numbers in their paper.
#
# Run on your training machine (needs conda, CUDA 11.1+, gcc 7.5+, cmake, zlib).
# NOT meant to run in a lightweight/no-GPU sandbox.
#
# Usage:
#   bash scripts/fetch_gnnome_chr21_graph.sh <install-dir>

set -euo pipefail

INSTALL_DIR="${1:?Usage: fetch_gnnome_chr21_graph.sh <install-dir>}"

echo "== Step 1: clone GNNome (active repo, not the deprecated one) =="
git clone https://github.com/lbcb-sci/GNNome.git "$INSTALL_DIR"
cd "$INSTALL_DIR"

echo "== Step 2: create conda env =="
conda create -y -n gnnome python=3.8 pip
# shellcheck disable=SC1091
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate gnnome
conda install -y cmake zlib

echo "== Step 3: install Python requirements =="
if command -v nvidia-smi >/dev/null 2>&1; then
  pip install -r requirements.txt
else
  echo "No GPU detected -- installing CPU requirements (inference-only)."
  pip install -r requirements_cpu.txt
fi

echo "== Step 4: build pbsim3 / Raven / hifiasm into vendor/ =="
python install_tools.py

echo "== Step 5: fetch the PBSIM3 sample profile =="
bash download_profile.sh

echo "== Step 6: point train_valid_chrs.py / config.py at chr21 =="
cat <<'EOF'
Manual step: open train_valid_chrs.py and config.py in this GNNome checkout
and confirm chr21 is listed as a test chromosome (it is, by default, in the
paper's config -- test set is built from the real CHM13 chr21). Then place
chr21.fasta in the <chrdir> you pass below.
EOF

echo "== Step 7: generate the chr21 graph via GNNome's own generate_data.py =="
echo "Run (fill in your paths):"
echo "  python generate_data.py --datadir <datadir> --chrdir <chrdir> --asm raven --threads <N>"
echo ""
echo "This runs PBSIM3 -> Raven internally and writes GNNome's chr21 graph"
echo "in the exact format train.py expects for Full and Half model configs."

